// backend/prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String    @id @default(cuid())
  name        String?
  email       String?   @unique
  username    String?   @unique
  password    String?
  role        Role      @default(VISITOR)
  image       String?
  googleId    String?   @unique
  provider    String?   @default("local") // "local" | "google"
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  createdProperties Property[]    @relation("PropertyCreatedBy")
  updatedProperties Property[]    @relation("PropertyUpdatedBy")
  activityLogs      ActivityLog[]

  @@index([email])
  @@index([username])
  @@index([googleId])
  @@index([role])
  @@index([isActive])
  @@map("users")
}

model Property {
  id          String          @id @default(cuid())
  title       String
  slug        String          @unique
  description String
  price       Decimal         @db.Decimal(12, 2)
  priceUnit   PriceUnit       @default(MONTH)
  listingType ListingType     @default(RENT)
  location    String
  city        String
  state       String
  address     String
  latitude    Float?
  longitude   Float?
  type        PropertyType
  status      PropertyStatus  @default(ACTIVE)
  bedrooms    Int             @default(0)
  bathrooms   Int             @default(0)
  area        Float?
  areaUnit    String          @default("sqm")
  featured    Boolean         @default(false)
  images      PropertyImage[]
  videos      PropertyVideo[]
  amenities   Amenity[]
  viewCount   Int             @default(0)
  deletedAt   DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  createdById String?
  createdBy   User?           @relation("PropertyCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   User?           @relation("PropertyUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([city])
  @@index([type])
  @@index([status])
  @@index([featured])
  @@index([price])
  @@index([deletedAt])
  @@index([listingType])
  @@index([createdById])
  @@index([updatedById])
  @@map("properties")
}

model PropertyImage {
  id         String   @id @default(cuid())
  url        String
  publicId   String
  alt        String?
  order      Int      @default(0)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([propertyId])
  @@map("property_images")
}

model PropertyVideo {
  id           String   @id @default(cuid())
  url          String?
  videoId      String   // Bunny Stream video GUID
  thumbnailUrl String?
  title        String?
  duration     Int?     // seconds
  width        Int?
  height       Int?
  format       String?
  size         BigInt?  // bytes
  order        Int      @default(0)
  propertyId   String
  property     Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([propertyId])
  @@index([videoId])
  @@map("property_videos")
}

model Amenity {
  id         String   @id @default(cuid())
  name       String
  icon       String?
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@map("amenities")
}

model Message {
  id         String        @id @default(cuid())
  name       String
  email      String
  phone      String?
  subject    String
  body       String
  propertyId String?
  status     MessageStatus @default(UNREAD)
  deletedAt  DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([status])
  @@index([deletedAt])
  @@map("messages")
}

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      String
  description String?
  entityType  String?
  entityId    String?
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("activity_logs")
}

enum Role {
  VISITOR
  STAFF
  ADMIN
  SUPER_ADMIN
}

enum PropertyType {
  APARTMENT
  HOUSE
  STUDIO
  DUPLEX
  PENTHOUSE
  COMMERCIAL
  LAND
}

enum PropertyStatus {
  ACTIVE
  INACTIVE
  RENTED
}

enum PriceUnit {
  MONTH
  YEAR
  WEEK
  DAY
}

enum ListingType {
  RENT
  SALE
}

enum MessageStatus {
  READ
  UNREAD
}
