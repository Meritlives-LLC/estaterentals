# Backend
DATABASE_URL="postgresql://user:password@localhost:5432/jerryhomes"
JWT_SECRET="replace-with-long-random-secret"
JWT_REFRESH_SECRET="replace-with-long-random-secret"
PORT="5000"
ALLOWED_ORIGINS="http://localhost:3000"
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX="100"

# Cloudinary
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Bunny Stream
BUNNY_API_KEY="your-bunny-api-key"
BUNNY_LIBRARY_ID="your-bunny-library-id"

# Resend / email OTP
RESEND_API_KEY="your-resend-api-key"
RESEND_FROM_EMAIL="noreply@jerryhomes.ng"

# Geocoding
GEOCODING_BASE_URL="https://nominatim.openstreetmap.org/search"
GEOCODING_USER_AGENT="JerryHomes/1.0 your-email@example.com"

# Frontend
NEXT_PUBLIC_API_URL="http://localhost:5000/api"

# Server-side API proxy target (used by Next.js rewrites). In production
# set this to your Render API origin, e.g. https://estate-pgwv.onrender.com
ESTATE_API_URL="http://localhost:5000"
